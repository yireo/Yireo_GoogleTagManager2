/** @var Template $block */

use Magento\Framework\View\Element\Template;

$productPath = $block->getProductPath();
?>
<script<?= /* @noEscape */ $block->getCspMarkerAttribute() ?>>
    function yireoGoogleTagManager2FindParentElementWithName(element, parentTagName) {
        if (!element.parentElement) {
            return null;
        }

        if (element.parentElement.tagName.toLowerCase() === parentTagName) {
            return element.parentElement;
        }

        return yireoGoogleTagManager2FindParentElementWithName(element.parentElement, parentTagName);
    }

    function yireoGoogleTagManager2FindProductId(element) {
        const productItem = element.closest('[data-entity_id]');
        const entityId = productItem ? productItem.getAttribute('data-entity_id') : '';
        if (/^\d+$/.test(entityId)) {
            return entityId;
        }

        const form = yireoGoogleTagManager2FindParentElementWithName(element, 'form');
        const inputElement = form ? form.querySelector('input[name="product"]') : null;
        if (inputElement && inputElement.value) {
            return inputElement.value;
        }

        const itemInfo = element.closest('[id^="product-item-info_"]');
        const matches = itemInfo ? itemInfo.id.match(/^product-item-info_(\d+)$/) : null;

        return matches ? matches[1] : null;
    }

    const products = document.querySelectorAll('<?= $escaper->escapeJs($productPath) ?>');
    if (products && products.length > 0) {
        products.forEach(function(product) {
            product.addEventListener('click', function(event, s) {
                const productId = yireoGoogleTagManager2FindProductId(event.target);
                if (!productId) {
                    return;
                }

                const productData = window['YIREO_GOOGLETAGMANAGER2_PRODUCT_DATA_ID_' + productId] || {};
                productData.item_id = productId;

                const eventData = {
                    'event': 'select_item',
                    'ecommerce': {
                        'items': [productData]
                    }
                }

                yireoGoogleTagManager2Pusher(eventData, 'push (page event "select_item") [script-product-clicks.phtml]');

                if (window['YIREO_GOOGLETAGMANAGER2_DEBUG_CLICKS'] && confirm("Press to continue with redirect") === false) {
                    event.preventDefault();
                }
            });
        })
    }
</script>
